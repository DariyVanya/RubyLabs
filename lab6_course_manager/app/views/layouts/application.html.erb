<!DOCTYPE html>
<html>
  <head>
    <title>Course Manager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Courses", courses_path, class: "navbar-brand" %>
        <div class="navbar-nav me-auto">
          <%= link_to "All courses", courses_path, class: "nav-link" %>
          <%= link_to "Starting soon", starting_soon_courses_path, class: "nav-link" %>
          <%= link_to "Categories", categories_path, class: "nav-link" %>
          <%= link_to "Instructors", instructors_path, class: "nav-link" %>
          <%= link_to "Topics", topics_path, class: "nav-link" %>
          <%= link_to "New course", new_course_path, class: "nav-link" %>
        </div>
      </div>
    </nav>
    <main class="container mt-4"><%= yield %></main>
  </body>
</html>

