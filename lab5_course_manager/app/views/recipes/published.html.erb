<h1>Published recipes</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Difficulty</th>
      <th>Cooking time</th>
      <th>Servings</th>
    </tr>
  </thead>
  <tbody>
    <% @recipes.each do |recipe| %>
      <tr>
        <td><%= link_to recipe.title, recipe %></td>
        <td><%= recipe.category %></td>
        <td><%= recipe.difficulty %></td>
        <td><%= recipe.cooking_time %></td>
        <td><%= recipe.servings %></td>
      </tr>
    <% end %>
  </tbody>
</table>
