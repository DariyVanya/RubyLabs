<h1><%= @recipe.title %></h1>

<dl>
  <dt>Category</dt>
  <dd><%= @recipe.category %></dd>
  <dt>Difficulty</dt>
  <dd><%= @recipe.difficulty %></dd>
  <dt>Cooking time</dt>
  <dd><%= @recipe.cooking_time %></dd>
  <dt>Servings</dt>
  <dd><%= @recipe.servings %></dd>
  <dt>Published</dt>
  <dd><%= @recipe.published? ? "Yes" : "No" %></dd>
</dl>

<%= link_to "Edit", edit_recipe_path(@recipe), class: "btn btn-outline-primary" %>
<%= button_to "Delete", @recipe, method: :delete, class: "btn btn-outline-danger" %>
