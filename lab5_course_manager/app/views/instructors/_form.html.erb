<%= form_with model: instructor, class: "row g-3" do |f| %>
  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: "form-control" %>
  </div>
  <div class="col-12">
    <%= f.label :course_id, class: "form-label" %>
    <%= f.collection_select :course_id, Course.all, :id, :title, {}, class: "form-select" %>
  </div>
  <div class="col-12">
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
