<%= form_with model: recipe do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :category %>
    <%= f.select :category, Category.pluck(:name) %>
  </div>
  <div>
    <%= f.label :cooking_time %>
    <%= f.number_field :cooking_time %>
  </div>
  <div>
    <%= f.label :servings %>
    <%= f.number_field :servings %>
  </div>
  <div>
    <%= f.label :difficulty %>
    <%= f.select :difficulty, Recipe.difficulties.keys %>
  </div>
  <div>
    <%= f.label :published %>
    <%= f.check_box :published %>
  </div>
  <%= f.submit %>
<% end %>
