<%= form_with model: course do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :category %>
    <%= f.select :category, Category.pluck(:name) %>
  </div>
  <div>
    <%= f.label :client %>
    <%= f.text_field :client %>
  </div>
  <div>
    <%= f.label :main_topic %>
    <%= f.text_field :main_topic %>
  </div>
  <div>
    <%= f.label :duration_hours %>
    <%= f.number_field :duration_hours %>
  </div>
  <div>
    <%= f.label :start_date %>
    <%= f.date_field :start_date %>
  </div>
  <div>
    <%= f.label :end_date %>
    <%= f.date_field :end_date %>
  </div>
  <div>
    <%= f.label :price %>
    <%= f.number_field :price, step: 0.01 %>
  </div>
  <div>
    <%= f.label :status %>
    <%= f.select :status, Course.statuses.keys %>
  </div>
  <%= f.submit %>
<% end %>
