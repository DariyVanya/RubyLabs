<%= form_with model: recipe, class: "row g-3" do |f| %>
  <div class="col-12">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :category, class: "form-label" %>
    <%= f.select :category, Category.pluck(:name), {}, class: "form-select" %>
  </div>
  <div class="col-md-6">
    <%= f.label :difficulty, class: "form-label" %>
    <%= f.select :difficulty, Recipe.difficulties.keys, {}, class: "form-select" %>
  </div>
  <div class="col-md-4">
    <%= f.label :cooking_time, class: "form-label" %>
    <%= f.number_field :cooking_time, class: "form-control" %>
  </div>
  <div class="col-md-4">
    <%= f.label :servings, class: "form-label" %>
    <%= f.number_field :servings, class: "form-control" %>
  </div>
  <div class="col-md-4 d-flex align-items-end">
    <div class="form-check">
      <%= f.check_box :published, class: "form-check-input" %>
      <%= f.label :published, class: "form-check-label" %>
    </div>
  </div>
  <div class="col-12">
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
