<h1 class="mb-3">Active courses</h1>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Title</th>
      <th>Duration hours</th>
      <th>Start date</th>
    </tr>
  </thead>
  <tbody>
    <% @courses.each do |course| %>
      <tr>
        <td><%= link_to course.title, course %></td>
        <td><%= course.duration_hours %></td>
        <td><%= status_badge(course) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
